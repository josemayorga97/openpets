{
  "name": "@repo/data-utils",
  "version": "1.0.0",
  "description": "Helper methods to interface with data",
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir ./dist && tsc-alias",
    "pull": "drizzle-kit pull --config drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "push": "drizzle-kit push --config drizzle.config.ts",
    "studio": "drizzle-kit studio --config drizzle.config.ts",
    "better-auth-generate": "npx @better-auth/cli generate --config auth-gen/auth.ts  --output=src/drizzle-out/auth-schema.ts"
  },
  "exports": {
    "./database": "./dist/db/database.js",
    "./schema": "./dist/db/schema.js",
    "./auth-schema": "./dist/db/auth-schema.js",
    "./auth": "./dist/auth/auth.js",
    "./auth/permissions": "./dist/auth/permissions.js",
    "./queries/*": "./dist/queries/*.js",
    "./zod-schema/*": "./dist/zod/*.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-auth": "1.6.11",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "kysely": "^0.29.2",
    "kysely-d1": "^0.4.0",
    "nanoid": "^5.1.11",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260522.1",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "tsc-alias": "^1.8.17",
    "wrangler": "^4.94.0"
  }
}
