		"typescript": "^6.0.3",
		"vitest": "~3.2.4",
		"drizzle-kit": "^0.31.10",
		"wrangler": "^4.59.3"
	},
	"dependencies": {
		"@repo/data-utils": "workspace:*",
		"better-auth": "1.6.11",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.9",
		"moment": "^2.30.1",
		"nanoid": "^5.1.11",
		"uuid": "^11.1.0",
		"workers-ai-provider": "^3.0.2",
		"zod": "^4.4.3"
	}
