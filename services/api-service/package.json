{
	"name": "@repo/api-service",
	"version": "0.0.0",
	"private": true,
	"exports": {
		"./app-type": {
			"types": "./src/hono/app-type.ts"
		}
	},
	"scripts": {
		"deploy:prod": "wrangler deploy --env prod",
		"deploy:stage": "wrangler deploy --env stage",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"cf-typegen": "wrangler types --env-interface BaseEnv --env stage",
