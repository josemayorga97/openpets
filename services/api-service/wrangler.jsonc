/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api-service",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"logs":{
			"enabled": true
		}
	},
	"env": {
		"stage": {
			"vars": {
				"TRUSTED_ORIGINS": "https://user-application-stage.workers.dev,https://shelter-application-stage.workers.dev,https://admin-application-stage.workers.dev",
				"LOG_LEVEL": "debug",
			},
			"d1_databases": [{
				"binding": "DB",
				"database_id": "79086d11-39f5-44fe-b976-960ee862c61f",
				"remote": true
			}],
			"r2_buckets": [{
				"binding": "OPEN_PETS_STORAGE",
				"bucket_name": "open-pets-stage",
				"remote": true
			}]
		},
		"prod": {
			"vars": {
				"TRUSTED_ORIGINS": "https://www.openpets.org,https://shelter.openpets.org,https://admin.openpets.org",
				"LOG_LEVEL": "info",
			},
			"d1_databases": [{
				"binding": "DB",
				"database_id": "8c29b8ef-ef3f-49b3-ba3e-eac069cd7218",
			}],
			"r2_buckets": [{
				"binding": "OPEN_PETS_STORAGE",
				"bucket_name": "open-pets-prod",
			}]
		}
	}
}