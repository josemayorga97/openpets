{
	"name": "shelter-application",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "CLOUDFLARE_ENV=stage vite dev --port 3000",
		"build:stage": "CLOUDFLARE_ENV=stage vite build --mode development",
		"build:prod": "CLOUDFLARE_ENV=prod vite build --mode production",
		"deploy:stage": "CLOUDFLARE_ENV=stage pnpm run build:stage && wrangler deploy --env stage",
		"deploy:prod": "CLOUDFLARE_ENV=prod pnpm run build:prod && wrangler deploy --env prod",
		"preview": "pnpm run build && vite preview",
		"test": "vitest run",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types --env stage",
		"reauth": "pnpm -w run reauth"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.26.0",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-collapsible": "^1.1.4",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@repo/api-client": "workspace:^",
		"@repo/auth": "workspace:^",
		"@repo/data-utils": "workspace:*",
		"@repo/ui": "workspace:^",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-form": "^1.27.5",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "latest",
		"@tanstack/router-plugin": "^1.132.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"lucide-react": "^1.16.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "latest",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"jsdom": "^29.1.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.0",
		"vitest": "^4.1.5",
		"wrangler": "^4.92.0"
	}
}